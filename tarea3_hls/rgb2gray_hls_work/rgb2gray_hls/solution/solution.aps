<AutoPilot:solution xmlns:AutoPilot="com.autoesl.autopilot.solution">
    <config>
        <config_interface m_axi_latency="64" m_axi_alignment_byte_size="64" m_axi_max_widen_bitwidth="512" default_interface="kernel" m_axi_conservative_mode="1" m_axi_addr64="1" m_axi_auto_max_ports="0"/>
        <config_rtl register_reset_num="3" deadlock_detection="sim"/>
        <config_dataflow strict_mode="warning"/>
        <config_export format="xo" ipname="rgb2gray_top"/>
    </config>
    <name>
        <value string="solution"/>
    </name>
    <project>
        <value string="rgb2gray_hls"/>
    </project>
    <flowTarget value="vitis"/>
    <targetInfo>
        <TargetInfo value="xcvc1902:-vsva2197:-2MP-e-S"/>
    </targetInfo>
    <libraryList>
        <library value="xilinx/versal/versal" name="DefaultPlatform"/>
    </libraryList>
    <clockList>
        <clock name="default" default="false" period="250MHz"/>
    </clockList>
</AutoPilot:solution>

