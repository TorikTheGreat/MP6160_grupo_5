digraph fsm_escritura {
  rankdir=LR; bgcolor="white"; pad=0.3; nodesep=0.8; ranksep=1.1;
  node [shape=circle, style="filled", fillcolor="#D6E8F7", fontname="DejaVu Sans", fontsize=11];
  edge [fontname="DejaVu Sans", fontsize=9, color="#555555"];
  label="FSM de escritura  (capacidad: 1 rafaga pendiente)";
  labelloc="t"; fontname="DejaVu Sans Bold"; fontsize=12;

  W_IDLE [label="W_IDLE\nawready=1"];
  W_DATA [label="W_DATA\nwready=1"];
  W_RESP [label="W_RESP\nbvalid=1"];

  W_IDLE -> W_DATA [label="awvalid && awready\ncaptura addr/len · bid←awid\nawready←0 · wready←1\nw_err_q←(size≠8B || burst≠INCR)"];
  W_DATA -> W_DATA [label="wvalid && wready && !WLAST\l   aw_len_q≠0 : escribe carriles · addr+=8 · aw_len_q-=1\l   aw_len_q==0 : beat sobrante, no escribe y marca error\l"];
  W_DATA -> W_RESP [label="wvalid && wready && WLAST\nwready←0 · bresp←SLVERR si aw_len_q≠0 o hubo error"];
  W_RESP -> W_IDLE [label="bvalid && bready\nawready←1 · limpia el error pegajoso"];
  XX [label="estado\nilegal (X)", style="filled,dashed", fillcolor="#EEEEEE"];
  XX -> W_IDLE [label="default: recupera\nawready←1 · wready←0 · bvalid←0", style=dashed, color="#888888"];
}
