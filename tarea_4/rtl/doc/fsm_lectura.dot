digraph fsm_lectura {
  rankdir=LR; bgcolor="white"; pad=0.3;
  node [shape=circle, style="filled", fillcolor="#CDEBCD", fontname="DejaVu Sans", fontsize=11];
  edge [fontname="DejaVu Sans", fontsize=9, color="#555555"];
  label="FSM de lectura  (independiente de la de escritura)";
  labelloc="t"; fontname="DejaVu Sans Bold"; fontsize=12;

  R_IDLE [label="R_IDLE\narready=1"];
  R_DATA [label="R_DATA\nrvalid=1"];

  R_IDLE -> R_DATA [label="arvalid && arready\ncaptura addr/len\nsirve el beat 0 · rlast=(arlen==0)"];
  R_DATA -> R_DATA [label="rvalid && rready && ar_len_q≠0\naddr+=8 · len-=1 · rdata←mem"];
  R_DATA -> R_IDLE [label="rvalid && rready && ar_len_q==0\nrvalid←0 · arready←1"];
  XX [label="estado\nilegal (X)", style="filled,dashed", fillcolor="#EEEEEE"];
  XX -> R_IDLE [label="default: recupera\narready←1 · rvalid←0", style=dashed, color="#888888"];
}
